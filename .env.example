# ═══════════════════════════════════════════════════
# Alisa Reaction Bot — Environment Configuration
# ═══════════════════════════════════════════════════

# ─── Required ──────────────────────────────────────

# Telegram Bot API token (get from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Your bot's username (without @)
BOT_USERNAME=YourBotUsername

# ─── Reactions ─────────────────────────────────────

# List of emojis the bot will use for reactions
# Example: 👍❤🔥🥰👏😁🎉🤩🙏👌🕊😍🐳❤‍🔥💯⚡🏆
EMOJI_LIST=👍❤🔥🥰👏😁🎉🤩🙏

# ─── Behavior ──────────────────────────────────────

# Randomness level for group chat reactions (0-10)
# 0 = react to every message (default)
# 10 = very random, rarely react
RANDOM_LEVEL=0

# Comma-separated list of chat IDs where bot should NOT react
# Example: -1001234567890,-1009876543210
RESTRICTED_CHATS=

# ─── Security ──────────────────────────────────────

# Bot owner's Telegram user ID (for /broadcast, /log commands)
# Get your ID: send /start to @userinfobot
OWNER_ID=

# Webhook secret token for validating incoming requests
# Generate: openssl rand -hex 32
# Set via BotFather: /setwebhook → secret_token parameter
WEBHOOK_SECRET=

# ─── Server ────────────────────────────────────────

# Bot photo URL (sends with /start, /help, /about, /stats, /donate, /reactions)
# Must be a valid URL or Telegram file_id
BOT_PHOTO=

# Server port (for Docker/VPS deployments)
PORT=3000

# Node environment
NODE_ENV=production

# ─── Alisa Chat (Groq + Gemini) ────────────────────

# Groq API key (PRIMARY — FREE, 30 RPM, fast Llama 3.3)
# Get yours at: https://console.groq.com
# GROQ_API_KEY=

# Google Gemini API key (FALLBACK — FREE, 15 RPM)
# Get yours at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# ─── Persistent Storage (Redis) ───────────────────

# Option 1: Upstash Redis (FREE — 10,000 req/day, 256MB)
# Sign up at https://console.upstash.com, create a Redis database,
# then copy the REST URL and TOKEN below.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Option 2: Vercel KV (PAID — starts at $8/month)
# Create a KV store in your Vercel dashboard
# (Storage → Create Database → KV). Vercel auto-injects these vars.
# For local/Docker/Render: leave unset — uses data/state.json file instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
